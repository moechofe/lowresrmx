global h

w=shown.w :h=shown.h
'w=180 :h=180 :'for thumbnail

x=(w\16)-3
bg copy 0,0,7,2 to x,(h\8)*1/4-1
bg copy 0,0,7,2 to x,(h\8)*3/4-1
sub r
  if raster=h\2 then
    copy rom(4),8 to $ff00
  else if raster=0 then
    copy rom(1),8 to $ff00
  end if
end sub

on raster call r

do
  wait vbl
loop


