data 0,"Retro Game Creator beta version 1.0"
data 0,""
data 1,"Thank you for downloading LowRes RMX!"
data 0,""
data 1,"Please note the features available on each platform:"
data 0,""
data 0,"iOS: The most mature version. It includes a code editor and allows you to share programs on the community website."
data 0,""
data 0,"Android: Currently in testing. It includes a code editor and lets you share programs on the community website."
data 0,""
data 0,"Desktop: Works well, but it is not the main target platform. You should use your own external code editor, as there is currently no solution to publish to the community website."
data 0,""
data 1,"Built-in Editors"
data 0,""
data 0,"GFX Program: Allows you to edit characters, palettes, and backgrounds using a minimal feature set."
data 0,""
data 0,"GFX Designer & Sound Composer: Advanced editor tools inherited from the original app Retro Game Creator is based on. They are powerful tools for editing characters, palettes, backgrounds, sound effects, and music, though the interface elements may appear small depending on your screen size."
data 0,""
data 1,"Community"
data 0,""
data 0,"Visit ret.ro.it to share programs and connect with other community members!"
data 0,""
data 0,"------------"
data 0,""
data -1

'detect layout change
restart:
cls
w=shown.w :h=shown.h

'create a window and store position
global l,t
l=ceil(safe.l/8)+1
r=floor((w-safe.r)/8)-1
t=ceil(safe.t/8)+1
b=floor((h-safe.b)/8)-1
window l,t,r-l,b-t,0

'for cursor blink
global blink,cx,cy
cx=0 :cy=0
global speedup
speedup=1
sub v
  if timer mod 40>15 then
    text l+cx,t+cy,"_"
  else
    text l+cx,t+cy," "
  end if
  if touch then
    speedup=9
  else
    speedup=1
  end if
end sub
on vbl call v

'print next line
next_line:
  read p
  if p<0 then
    restore
    goto next_line
  end if
  pal p
  read msg$
next_word:
  space=instr(msg$," ")
  if space>0 then
    word$=left$(msg$,space)
    msg$=mid$(msg$,space+1,len(msg$))
  else
    word$=msg$
    msg$=""
  end if
  print word$;
  cx=cursor.x :cy=cursor.y
  bg fill l+cx,t+cy to l+r,t+cy char 0
  f=9 :gosub wait_a_bit
  text l+cx,t+cy," "
  if len(msg$)>0 then goto next_word
  print
  cx=cursor.x :cy=cursor.y
  bg fill l+cx,t+cy to l+r,t+cy char 0
  f=90 :gosub wait_a_bit
  text l+cx,t+cy," "
  goto next_line

'wait a couple of frames
wait_a_bit:
  while f>1
    if w<>shown.w or h<>shown.h then goto restart
    wait vbl
    add f,-1*speedup
  wend
  return

