# Uncomment this line to define a global platform for your project
# platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  podfile_dir = File.dirname(File.realpath(__FILE__))

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # zstandard_ios 1.5.0 ships no C sources. A "Sync zstd" script phase rsyncs ~50 .c
    # files out of zstandard_native at build time, and a "Remove synced zstd" phase
    # rm -rf's them again after every successful build. The sync phase declares only
    # zstd.h as an output, so Xcode sees no dependency between it and the compile tasks
    # for the other sources and schedules them in parallel — whichever files rsync has
    # not written yet fail the build with "Build input file cannot be found:
    # .../zstdmt_compress.c". Which files lose the race varies, so it reads as flaky,
    # and every green build arms the next failure by deleting the tree again.
    #
    # Sync once here, drop the destructive phase, and make the surviving sync phase a
    # no-op when the sources are already present — it opens with its own rm -rf.
    # Remove all of this once upstream stops deleting its own sources.
    next unless target.name == 'zstandard_ios'

    sync_script = File.join(podfile_dir, '.symlinks', 'plugins', 'zstandard_ios', 'scripts', 'sync_zstd.sh')
    raise "zstandard_ios sync script not found: #{sync_script}" unless File.exist?(sync_script)
    raise "zstandard_ios sync failed: #{sync_script}" unless system('bash', sync_script)

    target.build_phases
          .select { |phase| phase.display_name.include?('Remove synced zstd') }
          .each(&:remove_from_project)

    target.build_phases.each do |phase|
      next unless phase.display_name.include?('Sync zstd')

      phase.shell_script = <<~SCRIPT
        if [ -f "${PODS_TARGET_SRCROOT}/Classes/zstd/zstd.h" ]; then
          exit 0
        fi
        bash "$(dirname "${PODS_TARGET_SRCROOT}")/scripts/sync_zstd.sh"
      SCRIPT
    end
  end
end
