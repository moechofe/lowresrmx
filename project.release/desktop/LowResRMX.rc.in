#include <windows.h>

1 ICON "@LOWRESRMX_ICO_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @LOWRESRMX_VERSION_COMMA@
PRODUCTVERSION @LOWRESRMX_VERSION_COMMA@
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Martin Mauchauffee\0"
      VALUE "FileDescription", "Retro Game Creator\0"
      VALUE "FileVersion", "@LOWRESRMX_VERSION@\0"
      VALUE "InternalName", "LowResRMX\0"
      VALUE "LegalCopyright", "Copyright 2016-2024 Timo Kloss, 2021-2026 Martin Mauchauffee\0"
      VALUE "OriginalFilename", "LowResRMX.exe\0"
      VALUE "ProductName", "LowResRMX\0"
      VALUE "ProductVersion", "@LOWRESRMX_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
