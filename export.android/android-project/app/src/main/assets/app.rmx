'file#1 contains palettes
'file#2 contains ball, racket character
'sprite#10 for the ball
'sprite#11 for player racket
'sprite#12 for cpu racket

'place a label to jump here later
restart:

'for the ball
'use floating point number for better precision

'place the ball in the middle of the screen: (screen - ball)/2
bx=(shown.w-7)/2
by=(shown.h-7)/2

'choice a direction angle for the ball
bangle=rnd*0.10+0.20+rnd(1)*0.5

'initial speed in pixel per frame
bspeed=1

'for player racket
'set the size of the sprite
sprite 11 size 2

'place the at the bottom center but stay inside the safe area
px=(shown.w-24)/2
py=(shown.h-safe.b-40)

'draw promotion link
ll=(shown.w-56)/16
lt=(shown.h-safe.b)/8-2
bg copy 0,0,7,2 to ll,lt
lr=ll+6
lb=lt+1

'for cpu racket
sprite 12 size 2

'place the at the top center but stay inside the safe area
cx=(shown.w-24)/2
cy=safe.t-3+40

'track score and time
score=0
start=timer
text (shown.w-24)/16-3,safe.t/8+1,"hi"

do

  'detect link tap
  if touch.tap then
    x=touch.x\8
    y=touch.y\8
    if x>=ll and x<=lr and y>=lt and y<=lb then
      'put magic number in memory
      poke $d999,123
    end if
  end if

  'print score
  number (shown.w-24)/16,safe.t/8,score,3
  number (shown.w-24)/16,safe.t/8+1,peekw($e000),3

  'continously draw the ball
  sprite 10,bx,by,1
  'and the rackets
  sprite 11,px,py,2
  'and cpu racket
  sprite 12,cx,cy,2

  'check collision with the screen side: left and right
  if int(bx)>=0 then bangle=0.5-bangle
  if int(bx)<=shown.w-7 then bangle=0.5-bangle

  harder=0

  'check collision with player racket
  if bangle>=0.5 and int(by+7)>=int(py) and int(by+7)<=int(py+2) and int(bx+3)>=int(px) and int(bx+7-3)<=int(px+24) then
    bangle=1-bangle
    harder=1
    play 0,42,6
    haptic 4
  end if

  'check collision with cpu racket
  if bangle<=0.5 and int(by)<=int(cy+2) and int(by+2)>=int(cy+2) and int(bx+3)>=int(cx) and int(bx+7-3)<=int(cx+24) then
    bangle=1-bangle
    harder=1
    play 0,30,6
    haptic 5
  end if

  'normalize ball angle
  if bangle<0 then add bangle,1
  if bangle>1 then add bangle,-1

  if harder then
    'increase speed
    if bspeed<7.5 then add bspeed,1/5
    'give more angle to the ball
    if bangle>0.05 and bangle<0.25 then add bangle,-0.025
    if bangle>0.25 and bangle<0.45 then add bangle,0.025
  end if

  'move the ball for the next time
  add bx,cos(bangle)*bspeed
  add by,sin(bangle)*bspeed

  'move the player racket using touch and clamp it's position inside the screen
  if touch then
    px=touch.x-12
    px=clamp(px,0,shown.w-24)
  end if

  'move the cpu racket
  cx=bx+3.5-12
  'player cheat
  'px=cx

  'detect when player loose
  if by>shown.h then
    goto restart
  end if

  'increase score
  add score,(timer-start)/8000
  if score>999 then score=999
  if score>peekw($e000) then pokew $e000,score

  wait vbl
loop


