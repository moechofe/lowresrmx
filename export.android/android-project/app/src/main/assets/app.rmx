
'top and bottom unsafe zone
bg 1
bg fill 0,0 to 63,0 char 1
sub r
if raster<safe.t or raster>=shown.h-safe.b then
  scroll 1,0,-raster
else
  scroll 1,0,-raster-8
end if
end sub
on raster call r

'left unsafe zone
bg 2
bg fill 62,0 to 63,63 char 1
scroll 2,-safe.l,0

'right unsafe zone
bg 3
bg fill 0,0 to 1,63 char 1
scroll 3,-shown.w+safe.r,0

print "safe zone are region where visual content is not hidden by camera notch or system bars."
print "but also, are zone guaranty to be accessible by a finger touch."
print
print "the =safe.l/t/r/b function return how many pixels not taking part of the safe zone in the left, top, right and bottom side of the device screen."
print
print "on ipad, even when device is rotated, the safe values do not change."

do
wait vbl
loop


